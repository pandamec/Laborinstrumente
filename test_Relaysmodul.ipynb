   "id": "61b3a3fa",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Replace 'COM3' with your ESP32 port\n",
    "COM='COM7'\n",
    "ser = serial.Serial(COM, 115200, timeout=1)\n",
    "time.sleep(5)\n",
    "\n",
    "ch1 = \"0b0001000000001000\\n\"\n",
    "\n",
    "ser.write(ch1.encode())\n",
    "\n",
    "#time.sleep(1)\n",
    "\n",
    "print(ser.readline().decode().strip())"
   ]
  }
